PORT=5000

NODE_ENV=development

# for token 
JWT_SECRET=myVeryStrongSecret

JWT_EXPIRES_IN=1d

# for refresh token and access token
JWT_ACCESS_SECRET=ecommerce_access_secret

JWT_REFRESH_SECRET=ecommerce_refresh_secret

ACCESS_TOKEN_EXPIRES_IN=15m

REFRESH_TOKEN_EXPIRES_IN=7d

DB_URL=mongodb://localhost:27017/ecommerce

BCRYPT_SALT_ROUNDS=10